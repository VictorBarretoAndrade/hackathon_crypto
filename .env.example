# Copy this file to .env.local and fill in the blanks. Never commit .env.local.

# Recebi only runs on devnet. Any other value makes the app refuse to start.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Devnet RPC URL with an API key (e.g. Helius). Leave empty to use the public
# fallback https://api.devnet.solana.com, which rate-limits quickly.
NEXT_PUBLIC_RPC_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Accepted stablecoins, as a JSON array. Keep the single quotes in this file;
# on Vercel, paste the JSON without them.
# Default: Circle's devnet USDC. scripts/seed-demo.ts appends a test mint.
NEXT_PUBLIC_STABLE_MINTS='[{"mint":"4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU","symbol":"USDC","decimals":6,"label":"USDC (devnet)"}]'

# Supabase, server only. The service_role key bypasses RLS: never expose it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
